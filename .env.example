# Copy to .env for local configuration. Never commit real credentials.
# Existing options: docs/full-guide.md and docs/LLM_CONFIG_GUIDE.md.
STOCK_LIST=600519,hk00700,AAPL
LITELLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
REPORT_LANGUAGE=zh
ENABLE_REALTIME_QUOTE=true

# Optional personal-quant bridge (docs/personal-quant-integration.md).
# Install requirements-personal-quant.txt first. Leave empty for legacy routing.
# Supply absolute paths for your deployment; mount canonical data read-only in Docker.
PERSONAL_QUANT_CANONICAL_DIR=
PERSONAL_QUANT_METADATA_POLICY=
# false: stop on a canonical read failure; true: explicitly allow legacy live providers.
PERSONAL_QUANT_ALLOW_FALLBACK=false

# Existing Longbridge live adapter credentials; the read-only bridge does not need them.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# Notifications remain opt-in through your existing channel configuration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WECHAT_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=

# Advanced multi-channel alternatives (uncomment one group and fill its model/API key).
